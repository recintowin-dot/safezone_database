# Environment variables - Copy to .env and fill in your values

# Database Configuration (REQUIRED - PostgreSQL only)
# For local PostgreSQL: postgresql://username:password@localhost:5432/safe_zone_db
# For Render: DATABASE_URL is automatically set via the Render dashboard from the PostgreSQL database
# This application requires PostgreSQL for persistent data storage.
DATABASE_URL=postgresql://username:password@localhost:5432/safe_zone_db

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Server Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
