# Environment variables - Copy to .env and fill in your values

# Database Configuration
# If you want to use SQLite (local/dev) the app will default to `sqlite:///./safe_zone.db` when
# `DATABASE_URL` is not set. On Render the filesystem is ephemeral so data may be lost on redeploys.
# To use Render Postgres set DATABASE_URL to the connection string shown in the Render Database page.
# Example PostgreSQL URL: postgresql://username:password@host:5432/dbname
# Example local SQLite URL: sqlite:///./safe_zone.db
DATABASE_URL=sqlite:///./safe_zone.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Server Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
