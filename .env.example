# Environment variables - Copy to .env and fill in your values

# Database Configuration
# For SQLite: sqlite:///./safe_zone.db
# For PostgreSQL: postgresql://user:password@localhost:5432/safe_zone
# For MySQL: mysql://user:password@localhost:3306/safe_zone
DATABASE_URL=sqlite:///./safe_zone.db

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Server Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
