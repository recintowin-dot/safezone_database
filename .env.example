# Environment variables - Copy to .env and fill in your values

# Database Configuration
# For local SQLite: sqlite:///./safe_zone.db (WARNING: Data lost on app restart on Render)
# For PostgreSQL: postgresql://user:password@localhost:5432/safe_zone (RECOMMENDED - Data is persistent)
# For Render: DATABASE_URL is automatically set via the Render dashboard from the PostgreSQL database
DATABASE_URL=postgresql://user:password@localhost:5432/safe_zone_db

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Server Configuration
DEBUG=False
HOST=0.0.0.0
PORT=8000
